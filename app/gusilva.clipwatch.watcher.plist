<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>         <string>gusilva.clipwatch.watcher</string>
  <!-- Relative to Clipwatch.app: no absolute paths, so the app can live anywhere. -->
  <key>BundleProgram</key> <string>Contents/MacOS/clipwatch</string>
  <key>ProgramArguments</key>
  <array>
    <string>clipwatch</string>
    <string>watch</string>
  </array>
  <key>KeepAlive</key>     <true/>
  <key>ProcessType</key>   <string>Interactive</string>
</dict>
</plist>
