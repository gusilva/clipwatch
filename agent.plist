<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>             <string>{{.Label | xml}}</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{.Exe | xml}}</string>
    <string>watch</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HERDR_PLUGIN_STATE_DIR</key> <string>{{.State | xml}}</string>
  </dict>
  <key>KeepAlive</key>
  <dict>
    <key>PathState</key>
    <dict>
      <key>{{.Exe | xml}}</key> <true/>
    </dict>
  </dict>
  <key>ProcessType</key>       <string>Interactive</string>
  <key>StandardOutPath</key>   <string>{{.LogPath | xml}}</string>
  <key>StandardErrorPath</key> <string>{{.LogPath | xml}}</string>
</dict>
</plist>
